# Use secure runtime environment settings. Never commit real credentials.
# Copy the Session pooler URI from Supabase's Connect dialog; URL-encode password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
CRICKET_REQUIRE_AUTH=true
CRICKET_DEMO_USERNAME=cricket
CRICKET_DEMO_PASSWORD=replace-with-a-random-secret-of-at-least-16-characters
# Local development needs none of these variables and uses SQLite on loopback.
# The app does not automatically load .env files.
